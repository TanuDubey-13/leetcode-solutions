#include <stdlib.h>
#include <string.h>

int longestValidParentheses(char* s) {

    int n = strlen(s);

    // dynamically allocated stack
    int* stack = (int*)malloc(sizeof(int) * (n + 1));
    int top = -1;

    int maxLen = 0;

    // base index
    stack[++top] = -1;

    for (int i = 0; i < n; i++) {

        if (s[i] == '(') {
            stack[++top] = i;
        } else {
            top--;

            if (top == -1) {
                stack[++top] = i;
            } else {
                int len = i - stack[top];
                if (len > maxLen)
                    maxLen = len;
            }
        }
    }

    free(stack);
    return maxLen;
}

