int smallestRangeI(int* nums, int numsSize, int k) {
    int min = nums[0];
    int max = nums[0];
    for(int i=0;i<numsSize;i++){
        if(nums[i]<min)
        min =nums[i];

        if(nums[i]>max)
        max=nums[i];
    }
    int ans = max -min-2*k;
    if(ans<0)
    return 0;

    return ans;
}