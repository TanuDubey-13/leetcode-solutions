#include <stdbool.h>

bool isPalindrome(int x) {

    // Fast rejection
    if (x < 0 || (x % 10 == 0 && x))
        return false;

    int rev = 0;

    // Reverse only half
    while (x > rev) {
        rev = rev * 10 + x % 10;
        x /= 10;
    }

    // Even or odd length check
    return (x == rev || x == rev / 10);
}
